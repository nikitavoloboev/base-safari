{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "Site Blocker",
  "description": "Block distracting sites",
  "version": "1.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false,
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": [
        "https://news.ycombinator.com/",
        "https://hckrnews.com/",
        "https://reddit.com/",
        "https://www.reddit.com/",
        "https://lobste.rs/",
        "https://youtube.com/",
        "https://www.youtube.com/",
        "https://github.com/dashboard-feed",
        "<all_urls>"
      ]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png",
      "256": "images/icon-256.png",
      "512": "images/icon-512.png"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ]
}
